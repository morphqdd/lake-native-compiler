@rt(rt_read)
@rt(rt_write)
@rt(rt_allocate)
+std.process.{ die }

stdreader is {
  id pid buf buf size i64 -> {
        rt_write(1 "Before read\n" 12)
        rt_read(0 buf size)
        rt_write(1 "After read\n" 11)
        id(0)
        rt_write(1 "End of stdreader\n" 17)
      }
}

stdwriter is {
  buf buf size i64 -> {
    rt_write(1 buf size)
  }
  buf str size i64 -> {
    rt_write(1 buf size)
  }
}

process is {
  _ -> {
    wait {
      self_id pid -> { self(self_id) }
    }
  }
  self_id pid -> {
    let r = rt_allocate(32)
    when r.0 {
      :ok -> {
        let buf = r.1
        stdreader(self_id buf 32)
        wait {
          _ -> {
            stdwriter(buf 32)
          }
        }
      }
      _ -> { die() }
    }
  }
}

main is {
  _ -> {
    let proc pid = process()
    proc(proc)
  }
}
