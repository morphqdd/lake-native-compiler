@rt(rt_write)

worker is {
  n i64 -> {
    when 1 <= n {
      true  -> { rt_write(1 "hello\n" 6) self(n-1) }
    }
  }
}

main is {
  _ -> {
    worker(10000)
    worker(10000)
    worker(10000)
    worker(10000)
    worker(10000)
    worker(10000)
    worker(10000)
    worker(10000)
    worker(10000)
    worker(10000)
  }
}
