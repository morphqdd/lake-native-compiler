# Compile-time tuning for the Lake CPU bench.
#
# LAKE_UNROLL — unroll factor for tail-self loop bodies (#85).  4 is the
# sweet spot on this workload: the worker's body is dispatch-bound at
# U=1 (15-20 inst/iter, most of it qb/branch_entry/branch_switch chain),
# and Cranelift's CSE/regalloc collapse the inlined chunk down to ~3
# inst per logical iter once it sees ≥4 copies in one basic block.
# Higher U has diminishing returns (U=16 ≈ U=4) and larger U pays JIT
# code-size cost without further runtime gain.
LAKE_UNROLL=4
