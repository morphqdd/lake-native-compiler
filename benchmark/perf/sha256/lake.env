# Loop-unroll factor for `fill_w` / `compress` (#85, multi-stmt
# self-arm relaxed in #88).  Sweep on the 1 MiB workload, battery-
# throttled laptop:
#
#   U=2   89.8 ± 6.6 ms   (not enough chunking, dispatch still dominates)
#   U=4   61.1 ± 2.3 ms   (sweet spot — best register pressure / icache)
#   U=8   64.0 ± 3.0 ms
#   U=16  67.8 ± 4.0 ms   (Cranelift regalloc spill cost starts climbing)
#   U=32  69.1 ± 2.6 ms
#
# fill_w runs 64 iters per block, compress 64 — both divisible by 4
# without a tail.  Higher factors swap iter overhead for instruction-
# cache and spill pressure on the chunk's basic block.
LAKE_UNROLL=4
