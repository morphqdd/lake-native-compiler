@rt(rt_write)

// Each spawned actor exits immediately — measures pure spawn + scheduler insert.
nop is { _ -> { } }

// Driver: spawns N actors, then exits.  Counts down via self() to keep
// the loop in CPS form.
driver is {
  n i64 -> {
    when 0 == n {
      true  -> { rt_write(1 "done\n" 5) }
      false -> { nop() self(n-1) }
    }
  }
}

// Free-list allocator + per-process death cleanup unblocks much higher N:
// spawned nops are reaped immediately so concurrent live count stays well
// under the 256-slot scheduler queue.  Tested up to 500_000 ok.
main is {
  _ -> { driver(100000) }
}
