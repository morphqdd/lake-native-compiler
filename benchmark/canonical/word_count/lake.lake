//       let nl i64 = b == 10
//       self(buf i - 1 lines + nl)
//     }
//   }
//   main is { _ -> {
//     let buf i64 = rt_allocate(4096)
//     let n i64 = rt_read(0 buf 4096)   // currently void, blocks impl
//     loop(buf n 0)
//   } }
