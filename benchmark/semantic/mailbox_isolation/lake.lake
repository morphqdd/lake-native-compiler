@rt(rt_write)

recv_a is {
  remaining i64 -> {
    when 1 <= remaining {
      true -> { wait { n i64 -> {
        rt_write(1 "A" 1)
        self(remaining-1)
      } } }
    }
  }
}

recv_b is {
  _ -> { wait { n i64 -> { rt_write(1 "B" 1) } } }
}

flood is {
  target pid count i64 -> {
    when 1 <= count {
      true -> { target(1) self(target count-1) }
    }
  }
}

main is {
  _ -> {
    let a pid = recv_a(50)
    let b pid = recv_b()
    flood(a 50)
    b(1)
  }
}
